<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LightNovelSelector.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LightNovelSelector.WinUI.Models"
    NavigationCacheMode="Required">

    <Grid x:Name="RootLayout" Background="Transparent" SizeChanged="OnRootLayoutSizeChanged">
        <NavigationView
            x:Name="ShellNavigation"
            AlwaysShowHeader="False"
            CompactPaneLength="64"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="224"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource NavigationSelectionColor}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource NavigationSelectionColor}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource NavigationSelectionColor}" />
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <Grid Margin="8,6,8,14" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="8">
                        <FontIcon FontSize="17" Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xE8F1;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontWeight="SemiBold" Text="LightNovel" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="智能整理器" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="WorkspaceNavigationItem" Content="整理工作台" IsSelected="True" Tag="workspace">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ActivityNavigationItem" Content="活动与报告" Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="12,8,12,12" Spacing="10">
                    <Border Height="1" Background="{ThemeResource DividerBrush}" />
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="安全工作流" />
                    <StackPanel x:Name="WorkflowStepsPanel" Spacing="8">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="WorkflowStep1Badge" Width="20" Height="20" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="10">
                                <TextBlock x:Name="WorkflowStep1Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource AppAccentBrush}" Text="1" />
                            </Border>
                            <TextBlock x:Name="WorkflowStep1Label" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="选择目录" />
                        </Grid>
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="WorkflowStep2Badge" Width="20" Height="20" Background="{ThemeResource SubtleSurfaceBrush}" CornerRadius="10">
                                <TextBlock x:Name="WorkflowStep2Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="2" />
                            </Border>
                            <TextBlock x:Name="WorkflowStep2Label" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="扫描预览" />
                        </Grid>
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="WorkflowStep3Badge" Width="20" Height="20" Background="{ThemeResource SubtleSurfaceBrush}" CornerRadius="10">
                                <TextBlock x:Name="WorkflowStep3Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="3" />
                            </Border>
                            <TextBlock x:Name="WorkflowStep3Label" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="检查并修正" />
                        </Grid>
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="WorkflowStep4Badge" Width="20" Height="20" Background="{ThemeResource SubtleSurfaceBrush}" CornerRadius="10">
                                <TextBlock x:Name="WorkflowStep4Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="4" />
                            </Border>
                            <TextBlock x:Name="WorkflowStep4Label" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="执行整理" />
                        </Grid>
                    </StackPanel>
                    <Border
                        x:Name="CompactWorkflowSummary"
                        Padding="9,7"
                        Background="{ThemeResource AccentSubtleBrush}"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="12" Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xE9D2;" />
                            <TextBlock x:Name="CompactWorkflowStepText" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="当前：选择目录" />
                        </StackPanel>
                    </Border>
                    <Border Padding="9,6" Background="{ThemeResource SuccessSubtleBrush}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource SuccessTextBrush}" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource SuccessTextBrush}" Text="本地安全处理" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="1">
                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="LIGHT NOVEL SELECTOR" />
                        <TextBlock x:Name="VersionText" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="原生预览" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>

            <NavigationView.Content>
                <Grid Padding="26,18,26,24" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        x:Name="ConnectionRecoveryBar"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning"
                        Title="分类核心连接中断">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="ReconnectButton"
                                MinWidth="118"
                                Click="OnReconnectClick"
                                Style="{StaticResource ToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <ProgressRing
                                        x:Name="ReconnectProgressRing"
                                        Width="15"
                                        Height="15"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <FontIcon x:Name="ReconnectButtonIcon" FontSize="14" Glyph="&#xE72C;" />
                                    <TextBlock x:Name="ReconnectButtonText" Text="重新连接" />
                                </StackPanel>
                            </Button>
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <Grid x:Name="WorkspaceView" Grid.Row="1" RowSpacing="12">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="CompactWorkspaceState">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="DetailColumn.Width" Value="0" />
                                        <Setter Target="DetailCard.Visibility" Value="Collapsed" />
                                        <Setter Target="ShellNavigation.IsPaneOpen" Value="False" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="WideWorkspaceState">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="1120" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="DetailColumn.Width" Value="360" />
                                        <Setter Target="DetailCard.Visibility" Value="Visible" />
                                        <Setter Target="ShellNavigation.IsPaneOpen" Value="True" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="WorkspaceHeader">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="资料库操作" />
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="整理工作台" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="先预览识别结果，确认无误后再执行文件移动。" />
                            </StackPanel>
                            <Border
                                x:Name="ConnectionBadge"
                                Grid.Column="1"
                                Padding="11,5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{ThemeResource SuccessTextBrush}" />
                                    <TextBlock x:Name="ConnectionText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" FontSize="12" Text="正在连接核心" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border
                            x:Name="FolderCard"
                            Grid.Row="1"
                            AllowDrop="True"
                            DragEnter="OnFolderDragEnter"
                            DragLeave="OnFolderDragLeave"
                            DragOver="OnFolderDragOver"
                            Drop="OnFolderDrop"
                            Style="{StaticResource HeroCardBorderStyle}">
                            <Border.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.100" />
                            </Border.BackgroundTransition>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="FolderIconSurface" Width="44" Height="44" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="8">
                                    <FontIcon Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xED25;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="轻小说目录" />
                                    <TextBlock
                                        x:Name="FolderPathText"
                                        MaxLines="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="选择一个目录，或将目录拖放到这里"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="OpenFolderButton"
                                        AutomationProperties.Name="在文件资源管理器中打开目录"
                                        Click="OnOpenFolderClick"
                                        IsEnabled="False"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTipService.ToolTip="在文件资源管理器中打开">
                                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                                    </Button>
                                    <Button
                                        x:Name="ChooseFolderButton"
                                        Click="OnChooseFolderClick"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="选择目录 (Ctrl+O)">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="15" Glyph="&#xE8DA;" />
                                            <TextBlock Text="选择目录" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="ScanButton"
                                        MinWidth="132"
                                        AutomationProperties.Name="扫描并预览"
                                        Click="OnScanClick"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        ToolTipService.ToolTip="扫描并预览 (F5)">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="F5" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <ProgressRing x:Name="ScanProgressRing" Width="15" Height="15" IsActive="False" Visibility="Collapsed" />
                                            <FontIcon x:Name="ScanButtonIcon" FontSize="15" Glyph="&#xE721;" />
                                            <TextBlock x:Name="ScanButtonText" Text="扫描并预览" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="StatsGrid" Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource LowCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Margin="0,1,0,1" HorizontalAlignment="Left" Background="{ThemeResource SuccessTextBrush}" CornerRadius="2" />
                                    <StackPanel Margin="11,0,0,0" Spacing="2">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="待整理" />
                                        <TextBlock x:Name="ReadyCountText" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" Background="{ThemeResource SuccessSubtleBrush}" CornerRadius="8">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource SuccessTextBrush}" Glyph="&#xE73E;" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource LowCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Margin="0,1,0,1" HorizontalAlignment="Left" Background="{ThemeResource AppAccentBrush}" CornerRadius="2" />
                                    <StackPanel Margin="11,0,0,0" Spacing="2">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="识别系列" />
                                        <TextBlock x:Name="SeriesCountText" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="8">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xE8F1;" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource LowCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Margin="0,1,0,1" HorizontalAlignment="Left" Background="{ThemeResource WarningTextBrush}" CornerRadius="2" />
                                    <StackPanel Margin="11,0,0,0" Spacing="2">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="重复文件" />
                                        <TextBlock x:Name="DuplicateCountText" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" Background="{ThemeResource WarningSubtleBrush}" CornerRadius="8">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource WarningTextBrush}" Glyph="&#xE8C8;" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource LowCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Margin="0,1,0,1" HorizontalAlignment="Left" Background="{ThemeResource ErrorTextBrush}" CornerRadius="2" />
                                    <StackPanel Margin="11,0,0,0" Spacing="2">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="需要留意" />
                                        <TextBlock x:Name="AttentionCountText" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" Background="{ThemeResource ErrorSubtleBrush}" CornerRadius="8">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource ErrorTextBrush}" Glyph="&#xE7BA;" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3" MinHeight="310" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition x:Name="DetailColumn" Width="360" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ResultsCard" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <StackPanel Spacing="1">
                                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="识别队列" />
                                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="分类预览" />
                                            </StackPanel>
                                            <Border Style="{StaticResource PillBorderStyle}">
                                                <TextBlock x:Name="ResultCountText" AutomationProperties.LiveSetting="Polite" FontSize="12" Text="0 个文件" />
                                            </Border>
                                        </StackPanel>
                                        <Button
                                            x:Name="RefreshButton"
                                            Grid.Column="1"
                                            AutomationProperties.Name="重新扫描"
                                            Click="OnScanClick"
                                            IsEnabled="False"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTipService.ToolTip="重新扫描">
                                            <FontIcon FontSize="15" Glyph="&#xE72C;" />
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,0,0,10" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <AutoSuggestBox
                                            x:Name="ResultSearchBox"
                                            AutomationProperties.Name="搜索分类结果"
                                            PlaceholderText="搜索文件、系列或来源"
                                            TextChanged="OnResultSearchTextChanged">
                                            <AutoSuggestBox.QueryIcon>
                                                <FontIcon Glyph="&#xE721;" />
                                            </AutoSuggestBox.QueryIcon>
                                        </AutoSuggestBox>
                                        <ComboBox
                                            x:Name="SeriesFilter"
                                            Grid.Column="1"
                                            AutomationProperties.Name="按系列筛选"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="OnPlanFilterSelectionChanged">
                                            <ComboBoxItem Content="全部系列" Tag="" />
                                        </ComboBox>
                                        <ComboBox
                                            x:Name="StatusFilter"
                                            Grid.Column="2"
                                            AutomationProperties.Name="按状态筛选"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="0"
                                            SelectionChanged="OnPlanFilterSelectionChanged">
                                            <ComboBoxItem Content="全部状态" Tag="" />
                                            <ComboBoxItem Content="可执行" Tag="ready" />
                                            <ComboBoxItem Content="重复" Tag="duplicate" />
                                            <ComboBoxItem Content="冲突" Tag="conflict" />
                                            <ComboBoxItem Content="错误" Tag="error" />
                                            <ComboBoxItem Content="无需移动" Tag="unchanged" />
                                            <ComboBoxItem Content="已移动" Tag="moved" />
                                        </ComboBox>
                                        <Button
                                            x:Name="ClearFiltersButton"
                                            Grid.Column="3"
                                            AutomationProperties.Name="清除筛选"
                                            Click="OnClearFiltersClick"
                                            IsEnabled="False"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTipService.ToolTip="清除筛选">
                                            <FontIcon FontSize="14" Glyph="&#xE894;" />
                                        </Button>
                                        <FontIcon
                                            Grid.Column="4"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE946;"
                                            ToolTipService.ToolTip="筛选只改变当前显示，不会缩小确认整理的执行范围。" />
                                    </Grid>

                                    <Grid Grid.Row="2" Padding="12,0,12,7" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="状态" />
                                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="文件与系列" />
                                        <TextBlock Grid.Column="2" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="目标文件" />
                                        <TextBlock Grid.Column="3" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="置信度" />
                                        <TextBlock Grid.Column="4" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="来源" />
                                    </Grid>

                                    <Grid Grid.Row="3">
                                        <ListView
                                            x:Name="ResultsList"
                                            ItemContainerStyle="{StaticResource ResultItemContainerStyle}"
                                            ItemsSource="{x:Bind VisiblePlans}"
                                            SelectionChanged="OnResultSelectionChanged"
                                            Style="{StaticResource ResultListViewStyle}">
                                            <ListView.Resources>
                                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource ListHoverColor}" />
                                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{ThemeResource ListPressedColor}" />
                                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource ListSelectedColor}" />
                                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource ListSelectedHoverColor}" />
                                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource ListPressedColor}" />
                                            </ListView.Resources>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlanItem">
                                                    <Grid Padding="12,5" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="118" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="112" />
                                                            <ColumnDefinition Width="88" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{x:Bind Status, Converter={StaticResource StatusBrushConverter}, ConverterParameter=background}"
                                                            CornerRadius="8"
                                                            Padding="8,4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="12"
                                                                    Foreground="{x:Bind Status, Converter={StaticResource StatusBrushConverter}}"
                                                                    Text="{x:Bind Status, Converter={StaticResource StatusGlyphConverter}}" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="12"
                                                                    Foreground="{x:Bind Status, Converter={StaticResource StatusBrushConverter}}"
                                                                    Text="{x:Bind StatusLabel}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind SeriesName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{x:Bind TargetName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Note}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="5">
                                                            <TextBlock FontSize="12" Text="{x:Bind ConfidenceLabel}" />
                                                            <ProgressBar Width="76" Height="3" Maximum="1" Value="{x:Bind Confidence}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Column="4"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind ResolverSource}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <StackPanel x:Name="ResultsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                                            <Border Width="48" Height="48" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="8">
                                                <FontIcon FontSize="22" Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xED25;" />
                                            </Border>
                                            <TextBlock x:Name="ResultsEmptyTitleText" HorizontalAlignment="Center" FontWeight="SemiBold" Text="还没有分类预览" />
                                            <TextBlock x:Name="ResultsEmptyCopyText" HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="选择目录后开始扫描" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border x:Name="DetailCard" Grid.Column="1" Style="{StaticResource LowCardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="2,0,2,12" Spacing="1">
                                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="条目信息" />
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="文件详情" />
                                    </StackPanel>

                                    <StackPanel x:Name="DetailEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                                        <Border Width="48" Height="48" Background="{ThemeResource SubtleSurfaceBrush}" CornerRadius="8">
                                            <FontIcon FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8A5;" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="选择一个文件" />
                                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="这里会显示封面、简介和目标位置" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel x:Name="DetailLoadingState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                                        <ProgressRing Width="28" Height="28" IsActive="True" />
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="正在读取详情…" />
                                    </StackPanel>

                                    <ScrollViewer x:Name="DetailContent" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="14">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="112" Height="150" Background="{ThemeResource SubtleSurfaceBrush}" CornerRadius="8">
                                                    <Grid>
                                                        <FontIcon x:Name="CoverPlaceholder" FontSize="30" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8F1;" />
                                                        <Image x:Name="CoverImage" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="8">
                                                    <TextBlock x:Name="DetailTitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <Border x:Name="DetailStatusBadge" HorizontalAlignment="Left" CornerRadius="8" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock x:Name="DetailStatusIcon" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                                            <TextBlock x:Name="DetailStatusText" FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock x:Name="DetailConfidenceText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="DetailCoverSourceText" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Spacing="5">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="简介" />
                                                <TextBlock x:Name="DetailSummaryText" MaxLines="7" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="手动修正系列" />
                                                <TextBox x:Name="SeriesEditBox" MaxLength="120" PlaceholderText="系列文件夹名称" />
                                                <Button
                                                    x:Name="SaveCorrectionButton"
                                                    HorizontalAlignment="Stretch"
                                                    Click="OnSaveCorrectionClick"
                                                    Style="{StaticResource ToolbarButtonStyle}">
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                                                        <TextBlock Text="保存修正" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Spacing="5">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="目标位置" />
                                                <TextBlock x:Name="DetailTargetText" IsTextSelectionEnabled="True" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <InfoBar x:Name="DetailWarningBar" IsClosable="False" IsOpen="False" Severity="Warning" />

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="RevealFileButton" Click="OnRevealFileClick" HorizontalAlignment="Stretch" Style="{StaticResource ToolbarButtonStyle}">
                                                    <TextBlock HorizontalAlignment="Center" Text="定位文件" />
                                                </Button>
                                                <Button x:Name="OpenSubjectButton" Grid.Column="1" Click="OnOpenSubjectClick" HorizontalAlignment="Stretch" Style="{StaticResource ToolbarButtonStyle}">
                                                    <TextBlock HorizontalAlignment="Center" Text="作品资料" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="OperationCard" Grid.Row="4" Style="{StaticResource ElevatedCardBorderStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="OperationIconSurface" Width="36" Height="36" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="8">
                                    <FontIcon x:Name="OperationIcon" Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xE946;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <Grid>
                                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="当前操作" />
                                        <TextBlock x:Name="OperationProgressText" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                    <TextBlock x:Name="OperationMessageText" AutomationProperties.LiveSetting="Polite" FontWeight="SemiBold" Text="等待选择目录" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar x:Name="OperationProgressBar" Height="4" Maximum="100" Value="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="CancelButton" Click="OnCancelClick" Style="{StaticResource ToolbarButtonStyle}" Visibility="Collapsed">
                                        <TextBlock Text="停止" />
                                    </Button>
                                    <Button x:Name="UndoButton" Click="OnUndoClick" IsEnabled="False" Style="{StaticResource ToolbarButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                                            <TextBlock Text="撤销上次" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ApplyButton" MinWidth="118" Click="OnApplyClick" IsEnabled="False" Style="{StaticResource PrimaryActionButtonStyle}" ToolTipService.ToolTip="确认整理 (Ctrl+Enter)">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <ProgressRing x:Name="ApplyProgressRing" Width="15" Height="15" IsActive="False" Visibility="Collapsed" />
                                            <FontIcon x:Name="ApplyButtonIcon" FontSize="14" Glyph="&#xE73E;" />
                                            <TextBlock x:Name="ApplyButtonText" Text="确认整理" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="ActivityView" Grid.Row="1" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="ActivityHeader" Spacing="3">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="可追溯操作" />
                            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="活动与报告" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="查看本次会话记录，并按报告恢复上次文件移动。" />
                        </StackPanel>

                        <Border x:Name="ReportCard" Grid.Row="1" Style="{StaticResource ElevatedCardBorderStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="最近分类报告" />
                                    <TextBlock
                                        x:Name="ReportStatusText"
                                        MaxLines="1"
                                        Style="{StaticResource MutedTextStyle}"
                                        Text="当前目录还没有分类报告。"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <TextBlock x:Name="ReportMovedText" FontSize="12" Text="移动 0" />
                                        <TextBlock x:Name="ReportSkippedText" FontSize="12" Text="跳过 0" />
                                        <TextBlock x:Name="ReportDuplicateText" FontSize="12" Text="重复 0" />
                                        <TextBlock x:Name="ReportErrorText" FontSize="12" Text="错误 0" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="OpenReportButton" Click="OnOpenReportClick" IsEnabled="False" Style="{StaticResource ToolbarButtonStyle}">
                                        <TextBlock Text="打开报告" />
                                    </Button>
                                    <Button x:Name="ActivityUndoButton" Click="OnUndoClick" IsEnabled="False" Style="{StaticResource ToolbarButtonStyle}">
                                        <TextBlock Text="按报告撤销" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ReportItemsCard" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionTitleTextStyle}" Text="报告条目" />
                                    <Grid Grid.Row="1">
                                        <ListView ItemsSource="{x:Bind ReportItems}" SelectionMode="None">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,2" />
                                                    <Setter Property="CornerRadius" Value="6" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:ReportItem">
                                                    <Grid Padding="9,7" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="74" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{x:Bind Status, Converter={StaticResource StatusBrushConverter}, ConverterParameter=background}"
                                                            CornerRadius="8"
                                                            Padding="8,4">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{x:Bind Status, Converter={StaticResource StatusBrushConverter}}"
                                                                Text="{x:Bind OperationLabel}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind DestinationPath}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel x:Name="ReportItemsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                            <FontIcon FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE9D5;" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="生成分类报告后会在这里显示条目" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border x:Name="LogsCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="会话活动" />
                                    <Button
                                        AutomationProperties.Name="清空会话活动"
                                        HorizontalAlignment="Right"
                                        Click="OnClearVisibleLogsClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTipService.ToolTip="清空当前显示">
                                        <FontIcon FontSize="15" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                                <ListView Grid.Row="1" ItemsSource="{x:Bind Logs}" SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="42" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:LogEntry">
                                            <Grid Padding="8,7" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="66" />
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Time}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Kind, Converter={StaticResource LogKindConverter}}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="SettingsView"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SettingsContent" MaxWidth="900" Margin="0,0,0,12" HorizontalAlignment="Stretch" Spacing="12">
                            <StackPanel Margin="0,0,0,4" Spacing="3">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="应用偏好" />
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="设置" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="偏好会保存在当前 Windows 用户账户中。" />
                            </StackPanel>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="18">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="识别与文件处理" />
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="联网补全元数据" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="使用 Bangumi 补充标题、简介、封面和识别置信度。" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="NetworkToggle" Grid.Column="1" AutomationProperties.Name="联网补全元数据" Toggled="OnSettingsToggleChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="扫描子目录" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="包含所选目录内已经存在的子文件夹。" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="RecursiveToggle" Grid.Column="1" AutomationProperties.Name="扫描子目录" Toggled="OnSettingsToggleChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="建议自动重命名" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="根据电子书内容和单卷信息生成更整洁的目标文件名。" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AutoRenameToggle" Grid.Column="1" AutomationProperties.Name="建议自动重命名" Toggled="OnSettingsToggleChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="18">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="外观与动态效果" />
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="颜色模式" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="默认跟随 Windows，也可为本应用固定深色或浅色。" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SystemThemeStatusText" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" Text="当前跟随 Windows" />
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeSelector" Grid.Column="1" AutomationProperties.Name="颜色模式" HorizontalAlignment="Stretch" SelectionChanged="OnThemeSelectionChanged">
                                            <ComboBoxItem Content="跟随 Windows" Tag="system" />
                                            <ComboBoxItem Content="浅色" Tag="light" />
                                            <ComboBoxItem Content="深色" Tag="dark" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="窗口材质" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="亚克力更通透，云母更克制；系统关闭透明效果时会自动回退为实色。" TextWrapping="Wrap" />
                                            <TextBlock x:Name="MaterialStatusText" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="MaterialSelector"
                                            Grid.Column="1"
                                            AutomationProperties.Name="窗口材质"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="OnMaterialSelectionChanged">
                                            <ComboBoxItem Content="透明亚克力（推荐）" Tag="acrylic" />
                                            <ComboBoxItem Content="云母" Tag="mica" />
                                            <ComboBoxItem Content="实色" Tag="solid" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="减少动态效果" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="关闭非必要的进入、Toast 和按压动画。" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ReducedMotionToggle" Grid.Column="1" AutomationProperties.Name="减少动态效果" Toggled="OnReducedMotionToggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <StackPanel Spacing="3">
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="自定义分类规则" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="文件名命中匹配文本时，优先归入指定系列。" />
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Click="OnAddRuleClick" Style="{StaticResource ToolbarButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                                <TextBlock Text="添加规则" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ListView MaxHeight="310" ItemsSource="{x:Bind Rules}" SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,3" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:EditableRule">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox MaxLength="240" PlaceholderText="匹配文本，例如：刀剑神域" Text="{x:Bind Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnSettingsTextChanged" />
                                                    <TextBox Grid.Column="1" MaxLength="120" PlaceholderText="目标系列，例如：刀剑神域" Text="{x:Bind Series, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnSettingsTextChanged" />
                                                    <Button Grid.Column="2" AutomationProperties.Name="删除规则" Click="OnDeleteRuleClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="删除规则">
                                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="RulesEmptyText" Style="{StaticResource MutedTextStyle}" Text="尚未添加自定义规则。" />
                                </StackPanel>
                            </Border>

                            </StackPanel>
                        </ScrollViewer>
                        <Border
                            Grid.Row="1"
                            MaxWidth="900"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource ElevatedCardBorderStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="SettingsDirtyIcon" FontSize="13" Foreground="{ThemeResource SuccessTextBrush}" Glyph="&#xE73E;" />
                                    <TextBlock x:Name="SettingsDirtyText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="识别设置已保存" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Click="OnResetSettingsClick" Style="{StaticResource ToolbarButtonStyle}">
                                        <TextBlock Text="恢复当前已保存值" />
                                    </Button>
                                    <Button x:Name="SaveSettingsButton" Click="OnSaveSettingsClick" IsEnabled="False" Style="{StaticResource AccentButtonStyle}">
                                        <TextBlock Text="保存设置" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <Border
            x:Name="ToastHost"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="状态通知"
            MinWidth="320"
            MaxWidth="440"
            Margin="0,16,28,0"
            Padding="14,12"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{ThemeResource TransientSurfaceBrush}"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0"
            Visibility="Collapsed"
            Canvas.ZIndex="100">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="ToastIcon" VerticalAlignment="Top" FontSize="16" Glyph="&#xE946;" />
                <TextBlock x:Name="ToastMessageText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" AutomationProperties.Name="关闭通知" Click="OnDismissToastClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="关闭通知">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
