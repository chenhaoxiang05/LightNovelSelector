<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LightNovelSelector.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:LightNovelSelector.WinUI.Components"
    xmlns:models="using:LightNovelSelector.WinUI.Models"
    NavigationCacheMode="Required">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnSectionShortcutInvoked" />
        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnSectionShortcutInvoked" />
        <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnSectionShortcutInvoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchShortcutInvoked" />
        <KeyboardAccelerator Key="F6" Modifiers="Shift" Invoked="OnCycleRegionBackwardInvoked" />
        <KeyboardAccelerator Key="F6" Invoked="OnCycleRegionForwardInvoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootLayout" Background="Transparent" SizeChanged="OnRootLayoutSizeChanged">
        <NavigationView
            x:Name="ShellNavigation"
            AlwaysShowHeader="False"
            AutomationProperties.LandmarkType="Navigation"
            AutomationProperties.Name="主导航"
            CompactPaneLength="64"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="224"
            PaneClosed="OnNavigationPaneClosed"
            PaneDisplayMode="Left"
            PaneOpened="OnNavigationPaneOpened"
            PreviewKeyDown="OnShellNavigationPreviewKeyDown"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource NavigationSelectionColor}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource NavigationSelectionColor}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource NavigationSelectionColor}" />
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <Grid Margin="8,6,8,14" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="8">
                        <FontIcon FontSize="17" Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xE8F1;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontWeight="SemiBold" Text="LightNovel" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="智能整理器" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="WorkspaceNavigationItem"
                    AutomationProperties.AcceleratorKey="Control+1"
                    AutomationProperties.Name="整理工作台"
                    Content="整理工作台"
                    IsSelected="True"
                    Tag="workspace"
                    ToolTipService.ToolTip="整理工作台 (Ctrl+1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ActivityNavigationItem"
                    AutomationProperties.AcceleratorKey="Control+2"
                    AutomationProperties.Name="活动与报告"
                    Content="活动与报告"
                    Tag="activity"
                    ToolTipService.ToolTip="活动与报告 (Ctrl+2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <components:WorkflowRail x:Name="WorkflowRail" />
            </NavigationView.PaneFooter>

            <NavigationView.Content>
                <Grid x:Name="ShellContentGrid" Padding="26,18,26,24" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        x:Name="ConnectionRecoveryBar"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning"
                        Title="分类核心连接中断">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="ReconnectButton"
                                AutomationProperties.Name="重新连接分类核心"
                                Click="OnReconnectClick"
                                MinWidth="118"
                                Style="{StaticResource ToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <ProgressRing
                                        x:Name="ReconnectProgressRing"
                                        Width="15"
                                        Height="15"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <FontIcon x:Name="ReconnectButtonIcon" FontSize="14" Glyph="&#xE72C;" />
                                    <TextBlock x:Name="ReconnectButtonText" Text="重新连接" />
                                </StackPanel>
                            </Button>
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <ScrollViewer
                        x:Name="WorkspaceScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled">
                        <Grid
                            x:Name="WorkspaceView"
                            AutomationProperties.LandmarkType="Main"
                            AutomationProperties.Name="整理工作台主区域"
                            RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="WorkspaceHeader">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="资料库操作" />
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="整理工作台" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="先预览识别结果，确认无误后再执行文件移动。" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="UsageHelpButton"
                                    AutomationProperties.Name="查看使用提示"
                                    Click="OnShowUsageTipClick"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="查看安全整理流程">
                                    <FontIcon FontSize="14" Glyph="&#xE897;" />
                                </Button>
                                <Border
                                    x:Name="ConnectionBadge"
                                    AutomationProperties.AccessibilityView="Content"
                                    AutomationProperties.Name="分类核心连接状态"
                                    Padding="11,5"
                                    Background="{ThemeResource AccentSubtleBrush}"
                                    CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{ThemeResource SuccessTextBrush}" />
                                        <TextBlock x:Name="ConnectionText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" FontSize="12" Text="正在连接核心" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border
                            x:Name="FolderCard"
                            Grid.Row="1"
                            AllowDrop="True"
                            AutomationProperties.HelpText="可选择一个目录，或把目录及同目录中的文件拖放到这里。"
                            AutomationProperties.Name="轻小说目录导入区域"
                            DragEnter="OnFolderDragEnter"
                            DragLeave="OnFolderDragLeave"
                            DragOver="OnFolderDragOver"
                            Drop="OnFolderDrop"
                            Style="{StaticResource HeroCardBorderStyle}">
                            <Border.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.100" />
                            </Border.BackgroundTransition>
                            <Grid x:Name="FolderLayoutGrid" ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="FolderIconSurface" Width="44" Height="44" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="8">
                                    <FontIcon Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xED25;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="轻小说目录" />
                                    <TextBlock
                                        x:Name="FolderPathText"
                                        MaxLines="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="选择一个目录，或将目录拖放到这里"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    x:Name="FolderActions"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="OpenFolderButton"
                                        AutomationProperties.Name="在文件资源管理器中打开目录"
                                        Click="OnOpenFolderClick"
                                        IsEnabled="False"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTipService.ToolTip="在文件资源管理器中打开">
                                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                                    </Button>
                                    <Button
                                        x:Name="ChooseFolderButton"
                                        AutomationProperties.AcceleratorKey="Control+O"
                                        AutomationProperties.Name="选择轻小说目录"
                                        Click="OnChooseFolderClick"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="选择目录 (Ctrl+O)">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="15" Glyph="&#xE8DA;" />
                                            <TextBlock Text="选择目录" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="ScanButton"
                                        MinWidth="132"
                                        AutomationProperties.AcceleratorKey="F5"
                                        AutomationProperties.HelpText="扫描只生成预览，不会移动文件。"
                                        AutomationProperties.Name="扫描并预览"
                                        Click="OnScanClick"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        ToolTipService.ToolTip="扫描并预览 (F5)">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="F5" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <ProgressRing x:Name="ScanProgressRing" Width="15" Height="15" IsActive="False" Visibility="Collapsed" />
                                            <FontIcon x:Name="ScanButtonIcon" FontSize="15" Glyph="&#xE721;" />
                                            <TextBlock x:Name="ScanButtonText" Text="扫描并预览" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="StatsSurface"
                            Grid.Row="2"
                            Padding="0"
                            Style="{StaticResource LowCardBorderStyle}">
                            <Grid x:Name="StatsGrid" ColumnSpacing="0" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                            <Border x:Name="ReadyMetricTile" Style="{StaticResource MetricTileBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Margin="0,1,0,1" HorizontalAlignment="Left" Background="{ThemeResource SuccessTextBrush}" CornerRadius="2" />
                                    <StackPanel Margin="11,0,0,0" Spacing="2">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="待整理" />
                                        <TextBlock x:Name="ReadyCountText" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" Background="{ThemeResource SuccessSubtleBrush}" CornerRadius="8">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource SuccessTextBrush}" Glyph="&#xE73E;" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="SeriesMetricTile" Grid.Column="1" Style="{StaticResource MetricTileBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Margin="0,1,0,1" HorizontalAlignment="Left" Background="{ThemeResource AppAccentBrush}" CornerRadius="2" />
                                    <StackPanel Margin="11,0,0,0" Spacing="2">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="识别系列" />
                                        <TextBlock x:Name="SeriesCountText" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="8">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xE8F1;" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="DuplicateMetricTile" Grid.Column="2" Style="{StaticResource MetricTileBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Margin="0,1,0,1" HorizontalAlignment="Left" Background="{ThemeResource WarningTextBrush}" CornerRadius="2" />
                                    <StackPanel Margin="11,0,0,0" Spacing="2">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="重复文件" />
                                        <TextBlock x:Name="DuplicateCountText" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" Background="{ThemeResource WarningSubtleBrush}" CornerRadius="8">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource WarningTextBrush}" Glyph="&#xE8C8;" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="AttentionMetricTile" Grid.Column="3" Style="{StaticResource MetricTileBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Margin="0,1,0,1" HorizontalAlignment="Left" Background="{ThemeResource ErrorTextBrush}" CornerRadius="2" />
                                    <StackPanel Margin="11,0,0,0" Spacing="2">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="需要留意" />
                                        <TextBlock x:Name="AttentionCountText" Style="{StaticResource MetricValueTextStyle}" Text="0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" Background="{ThemeResource ErrorSubtleBrush}" CornerRadius="8">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource ErrorTextBrush}" Glyph="&#xE7BA;" />
                                    </Border>
                                </Grid>
                            </Border>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="WorkspaceDataSurface"
                            Grid.Row="3"
                            MinHeight="310"
                            Style="{StaticResource WorkspaceSurfaceBorderStyle}">
                            <SplitView
                                x:Name="DetailSplitView"
                                DisplayMode="Inline"
                                IsPaneOpen="True"
                                LightDismissOverlayMode="On"
                                OpenPaneLength="340"
                                PaneBackground="Transparent"
                                PanePlacement="Right">
                                <SplitView.Pane>
                                    <Border x:Name="DetailCard" Style="{StaticResource DetailRegionBorderStyle}">
                                        <components:FileDetailPane x:Name="DetailPane" />
                                    </Border>
                                </SplitView.Pane>
                                <Grid x:Name="ResultsDetailGrid">

                            <Border x:Name="ResultsCard" Style="{StaticResource ContentRegionBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <StackPanel Spacing="1">
                                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="识别队列" />
                                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="分类预览" />
                                            </StackPanel>
                                            <Border Style="{StaticResource PillBorderStyle}">
                                                <TextBlock x:Name="ResultCountText" AutomationProperties.LiveSetting="Polite" FontSize="12" Text="0 个文件" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                x:Name="CompactDetailButton"
                                                AutomationProperties.Name="查看所选文件详情"
                                                Click="OnCompactDetailClick"
                                                IsEnabled="False"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTipService.ToolTip="查看所选文件详情"
                                                Visibility="Collapsed">
                                                <FontIcon FontSize="15" Glyph="&#xE8A5;" />
                                            </Button>
                                            <Button
                                                x:Name="RefreshButton"
                                                AutomationProperties.Name="重新扫描"
                                                Click="OnScanClick"
                                                IsEnabled="False"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTipService.ToolTip="重新扫描">
                                                <FontIcon FontSize="15" Glyph="&#xE72C;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Grid
                                        x:Name="FilterGrid"
                                        Grid.Row="1"
                                        Margin="0,0,0,10"
                                        AutomationProperties.LandmarkType="Search"
                                        AutomationProperties.Name="分类结果筛选"
                                        ColumnSpacing="8"
                                        RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <AutoSuggestBox
                                            x:Name="ResultSearchBox"
                                            AutomationProperties.AcceleratorKey="Control+F"
                                            AutomationProperties.HelpText="搜索只改变当前显示，不会缩小确认整理的执行范围。"
                                            AutomationProperties.Name="搜索分类结果"
                                            PlaceholderText="搜索文件、系列或来源"
                                            TextChanged="OnResultSearchTextChanged"
                                            ToolTipService.ToolTip="搜索分类结果 (Ctrl+F)">
                                            <AutoSuggestBox.QueryIcon>
                                                <FontIcon Glyph="&#xE721;" />
                                            </AutoSuggestBox.QueryIcon>
                                        </AutoSuggestBox>
                                        <ComboBox
                                            x:Name="SeriesFilter"
                                            Grid.Column="1"
                                            AutomationProperties.Name="按系列筛选"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="OnPlanFilterSelectionChanged">
                                            <ComboBoxItem Content="全部系列" Tag="" />
                                        </ComboBox>
                                        <ComboBox
                                            x:Name="StatusFilter"
                                            Grid.Column="2"
                                            AutomationProperties.Name="按状态筛选"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="0"
                                            SelectionChanged="OnPlanFilterSelectionChanged">
                                            <ComboBoxItem Content="全部状态" Tag="" />
                                            <ComboBoxItem Content="可执行" Tag="ready" />
                                            <ComboBoxItem Content="重复" Tag="duplicate" />
                                            <ComboBoxItem Content="错误" Tag="error" />
                                            <ComboBoxItem Content="无需移动" Tag="unchanged" />
                                            <ComboBoxItem Content="已移动" Tag="moved" />
                                        </ComboBox>
                                        <Button
                                            x:Name="ClearFiltersButton"
                                            Grid.Column="3"
                                            AutomationProperties.Name="清除筛选"
                                            Click="OnClearFiltersClick"
                                            IsEnabled="False"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTipService.ToolTip="清除筛选">
                                            <FontIcon FontSize="14" Glyph="&#xE894;" />
                                        </Button>
                                        <FontIcon
                                            x:Name="FilterScopeInfoIcon"
                                            Grid.Column="4"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE946;"
                                            ToolTipService.ToolTip="筛选只改变当前显示，不会缩小确认整理的执行范围。" />
                                    </Grid>

                                    <Grid Grid.Row="2" Padding="12,0,12,7" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="状态" />
                                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="文件与系列" />
                                        <TextBlock Grid.Column="2" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="目标文件" />
                                        <TextBlock Grid.Column="3" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="置信度" />
                                        <TextBlock Grid.Column="4" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="来源" />
                                    </Grid>

                                    <Grid Grid.Row="3">
                                        <ListView
                                            x:Name="ResultsList"
                                            AutomationProperties.HelpText="筛选只改变当前显示。确认整理始终处理完整分类计划。"
                                            AutomationProperties.Name="分类预览结果"
                                            ItemContainerStyle="{StaticResource ResultItemContainerStyle}"
                                            SelectionChanged="OnResultSelectionChanged"
                                            Style="{StaticResource ResultListViewStyle}">
                                            <ListView.Resources>
                                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource ListHoverColor}" />
                                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{ThemeResource ListPressedColor}" />
                                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource ListSelectedColor}" />
                                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource ListSelectedHoverColor}" />
                                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource ListPressedColor}" />
                                            </ListView.Resources>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlanItem">
                                                    <Grid
                                                        AutomationProperties.AccessibilityView="Content"
                                                        AutomationProperties.Name="{x:Bind AccessibilityLabel}"
                                                        Padding="12,5"
                                                        ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="118" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="112" />
                                                            <ColumnDefinition Width="88" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{x:Bind Status, Converter={StaticResource StatusBrushConverter}, ConverterParameter=background}"
                                                            CornerRadius="8"
                                                            Padding="8,4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="12"
                                                                    Foreground="{x:Bind Status, Converter={StaticResource StatusBrushConverter}}"
                                                                    Text="{x:Bind Status, Converter={StaticResource StatusGlyphConverter}}" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="12"
                                                                    Foreground="{x:Bind Status, Converter={StaticResource StatusBrushConverter}}"
                                                                    Text="{x:Bind StatusLabel}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind SeriesName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{x:Bind TargetName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Note}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="5">
                                                            <TextBlock FontSize="12" Text="{x:Bind ConfidenceDisplayLabel}" />
                                                            <ProgressBar Width="76" Height="3" Maximum="1" Value="{x:Bind Confidence}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Column="4"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind ResolverSource}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <StackPanel x:Name="ResultsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                                            <Border Width="48" Height="48" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="8">
                                                <FontIcon FontSize="22" Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xED25;" />
                                            </Border>
                                            <TextBlock x:Name="ResultsEmptyTitleText" HorizontalAlignment="Center" FontWeight="SemiBold" Text="还没有分类预览" />
                                            <TextBlock x:Name="ResultsEmptyCopyText" HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="选择目录后开始扫描" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                                </Grid>
                            </SplitView>
                        </Border>

                        <Border x:Name="OperationCard" Grid.Row="4" Style="{StaticResource ElevatedCardBorderStyle}">
                            <Grid x:Name="OperationLayoutGrid" ColumnSpacing="14" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="OperationIconSurface" Width="36" Height="36" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="8">
                                    <FontIcon x:Name="OperationIcon" Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xE946;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <Grid>
                                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="当前操作" />
                                        <TextBlock x:Name="OperationProgressText" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="OperationMessageText"
                                        AutomationProperties.LiveSetting="Polite"
                                        AutomationProperties.Name="当前操作状态"
                                        FontWeight="SemiBold"
                                        Text="等待选择目录"
                                        TextTrimming="CharacterEllipsis" />
                                    <ProgressBar
                                        x:Name="OperationProgressBar"
                                        AutomationProperties.Name="当前操作进度"
                                        Height="4"
                                        Maximum="100"
                                        Value="0" />
                                </StackPanel>
                                <StackPanel
                                    x:Name="OperationActions"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="CancelButton"
                                        AutomationProperties.Name="停止当前操作"
                                        Click="OnCancelClick"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Visibility="Collapsed">
                                        <TextBlock Text="停止" />
                                    </Button>
                                    <Button
                                        x:Name="UndoButton"
                                        AutomationProperties.HelpText="根据最近一次分类报告恢复已移动的文件。"
                                        AutomationProperties.Name="撤销上次分类"
                                        Click="OnUndoClick"
                                        IsEnabled="False"
                                        Style="{StaticResource ToolbarButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                                            <TextBlock Text="撤销上次" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="ApplyButton"
                                        MinWidth="118"
                                        AutomationProperties.AcceleratorKey="Control+Enter"
                                        AutomationProperties.HelpText="打开确认对话框。即使当前有筛选，也会处理完整分类计划。"
                                        AutomationProperties.Name="确认整理全部分类计划"
                                        Click="OnApplyClick"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        ToolTipService.ToolTip="确认整理 (Ctrl+Enter)">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <ProgressRing x:Name="ApplyProgressRing" Width="15" Height="15" IsActive="False" Visibility="Collapsed" />
                                            <FontIcon x:Name="ApplyButtonIcon" FontSize="14" Glyph="&#xE73E;" />
                                            <TextBlock x:Name="ApplyButtonText" Text="确认整理" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        </Grid>
                    </ScrollViewer>

                    <Grid
                        x:Name="ActivityView"
                        Grid.Row="1"
                        AutomationProperties.LandmarkType="Main"
                        AutomationProperties.Name="活动与报告主区域"
                        RowSpacing="12"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="ActivityHeader" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="可追溯操作" />
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="活动与报告" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="查看每次整理记录，导出报告，或恢复指定批次。" />
                            </StackPanel>
                            <Button
                                x:Name="RefreshReportButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AcceleratorKey="F5"
                                AutomationProperties.Name="刷新分类历史"
                                Click="OnRefreshReportClick"
                                IsEnabled="False"
                                Style="{StaticResource ToolbarButtonStyle}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F5" />
                                </Button.KeyboardAccelerators>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <ProgressRing
                                        x:Name="ReportHistoryProgressRing"
                                        Width="15"
                                        Height="15"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    <TextBlock Text="刷新历史" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border x:Name="ReportCard" Grid.Row="1" Style="{StaticResource ElevatedCardBorderStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="所选分类批次" />
                                    <TextBlock
                                        x:Name="ReportStatusText"
                                        MaxLines="2"
                                        Style="{StaticResource MutedTextStyle}"
                                        Text="选择一个历史批次查看完整报告。"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <TextBlock x:Name="ReportMovedText" FontSize="12" Text="移动 0" />
                                        <TextBlock x:Name="ReportSkippedText" FontSize="12" Text="跳过 0" />
                                        <TextBlock x:Name="ReportDuplicateText" FontSize="12" Text="重复 0" />
                                        <TextBlock x:Name="ReportErrorText" FontSize="12" Text="错误 0" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="OpenReportButton"
                                        AutomationProperties.Name="打开所选分类报告"
                                        Click="OnOpenReportClick"
                                        IsEnabled="False"
                                        Style="{StaticResource ToolbarButtonStyle}">
                                        <TextBlock Text="打开" />
                                    </Button>
                                    <Button
                                        x:Name="ExportReportButton"
                                        AutomationProperties.Name="导出所选分类报告"
                                        Click="OnExportReportClick"
                                        IsEnabled="False"
                                        Style="{StaticResource ToolbarButtonStyle}">
                                        <TextBlock Text="导出" />
                                    </Button>
                                    <Button
                                        x:Name="ActivityUndoButton"
                                        AutomationProperties.HelpText="恢复所选批次中仍可安全撤销的文件移动。"
                                        AutomationProperties.Name="撤销所选分类批次"
                                        Click="OnActivityUndoClick"
                                        IsEnabled="False"
                                        Style="{StaticResource ToolbarButtonStyle}">
                                        <TextBlock Text="撤销此批次" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="270" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ReportHistoryCard" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,10" Spacing="3">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="分类历史" />
                                        <TextBlock
                                            x:Name="ReportHistoryStatusText"
                                            Style="{StaticResource MutedTextStyle}"
                                            Text="选择分类目录后会显示历史批次。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="ReportHistoryWarningText"
                                        Grid.Row="1"
                                        Margin="0,0,0,8"
                                        FontSize="11"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <Grid Grid.Row="2">
                                        <ListView
                                            x:Name="ReportHistoryList"
                                            AutomationProperties.Name="分类历史批次"
                                            ItemsSource="{x:Bind ReportHistory}"
                                            SelectionChanged="OnReportHistorySelectionChanged"
                                            SelectionMode="Single">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,2" />
                                                    <Setter Property="MinHeight" Value="68" />
                                                    <Setter Property="CornerRadius" Value="6" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:ReportHistoryEntry">
                                                    <Grid
                                                        AutomationProperties.AccessibilityView="Content"
                                                        AutomationProperties.Name="{x:Bind AccessibilityLabel}"
                                                        Padding="10,8"
                                                        RowSpacing="4"
                                                        ToolTipService.ToolTip="{x:Bind Path}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind TitleLabel}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind DisplayStatusLabel}" />
                                                        </Grid>
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind SummaryLabel}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel
                                            x:Name="ReportHistoryEmptyState"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="7">
                                            <FontIcon FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE823;" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="暂无分类历史" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3*" />
                                    <RowDefinition Height="2*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="ReportItemsCard" Style="{StaticResource CardBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionTitleTextStyle}" Text="报告条目" />
                                        <Grid Grid.Row="1">
                                            <ListView
                                                x:Name="ReportItemsList"
                                                AutomationProperties.Name="所选分类报告条目"
                                                ItemsSource="{x:Bind ReportItems}"
                                                SelectionMode="None">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0,2" />
                                                        <Setter Property="CornerRadius" Value="6" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ReportItem">
                                                        <Grid
                                                            AutomationProperties.AccessibilityView="Content"
                                                            AutomationProperties.Name="{x:Bind AccessibilityLabel}"
                                                            Padding="9,7"
                                                            ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="74" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Background="{x:Bind Status, Converter={StaticResource StatusBrushConverter}, ConverterParameter=background}"
                                                                CornerRadius="8"
                                                                Padding="8,4">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{x:Bind Status, Converter={StaticResource StatusBrushConverter}}"
                                                                    Text="{x:Bind OperationLabel}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind DestinationPath}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <StackPanel x:Name="ReportItemsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                                <FontIcon FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE9D5;" />
                                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="选择历史批次后会显示报告条目" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border x:Name="LogsCard" Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="会话活动" />
                                            <Button
                                                AutomationProperties.Name="清空会话活动"
                                                HorizontalAlignment="Right"
                                                Click="OnClearVisibleLogsClick"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTipService.ToolTip="清空当前显示">
                                                <FontIcon FontSize="15" Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                        <ListView
                                            x:Name="LogsList"
                                            Grid.Row="1"
                                            AutomationProperties.Name="当前会话活动日志"
                                            ItemsSource="{x:Bind Logs}"
                                            SelectionMode="None">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="MinHeight" Value="42" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:LogEntry">
                                                    <Grid
                                                        AutomationProperties.AccessibilityView="Content"
                                                        AutomationProperties.Name="{x:Bind AccessibilityLabel}"
                                                        Padding="8,7"
                                                        ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="66" />
                                                            <ColumnDefinition Width="82" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Time}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Kind, Converter={StaticResource LogKindConverter}}" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="SettingsView"
                        Grid.Row="1"
                        AutomationProperties.LandmarkType="Main"
                        AutomationProperties.Name="设置主区域"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SettingsContent" MaxWidth="900" Margin="0,0,0,12" HorizontalAlignment="Stretch" Spacing="12">
                            <StackPanel Margin="0,0,0,4" Spacing="3">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="应用偏好" />
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="设置" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="偏好会保存在当前 Windows 用户账户中。" />
                            </StackPanel>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="18">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="识别与文件处理" />
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="联网补全元数据" />
                                            <TextBlock
                                                x:Name="NetworkProviderDescriptionText"
                                                AutomationProperties.Name="当前元数据来源"
                                                Style="{StaticResource MutedTextStyle}"
                                                Text="正在读取可用的元数据来源。"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="NetworkToggle" Grid.Column="1" AutomationProperties.Name="联网补全元数据" Toggled="OnSettingsToggleChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="扫描子目录" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="包含所选目录内已经存在的子文件夹。" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="RecursiveToggle" Grid.Column="1" AutomationProperties.Name="扫描子目录" Toggled="OnSettingsToggleChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="建议自动重命名" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="根据电子书内容和单卷信息生成更整洁的目标文件名。" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AutoRenameToggle" Grid.Column="1" AutomationProperties.Name="建议自动重命名" Toggled="OnSettingsToggleChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="在线元数据来源" />
                                        <TextBlock
                                            Style="{StaticResource MutedTextStyle}"
                                            Text="可单独停用不需要的来源；优先级数字越小越先查询。故障来源会自动冷却，不会反复拖慢整批扫描。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid Padding="12,0" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="来源与健康状态" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource EyebrowTextStyle}" Text="优先级" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource EyebrowTextStyle}" Text="启用" />
                                    </Grid>
                                    <ListView
                                        x:Name="ProviderSettingsList"
                                        AutomationProperties.Name="在线元数据来源设置"
                                        IsItemClickEnabled="False"
                                        ItemsSource="{x:Bind Providers}"
                                        SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="8,8" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:EditableMetadataProvider">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="116" />
                                                        <ColumnDefinition Width="72" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Foreground="{ThemeResource AppAccentBrush}" Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                MaxLines="2"
                                                                Text="{x:Bind StatusDetail, Mode=OneWay}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="WrapWholeWords" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <NumberBox
                                                        Grid.Column="1"
                                                        AutomationProperties.Name="{x:Bind Name}"
                                                        LargeChange="10"
                                                        Maximum="1000"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        SpinButtonPlacementMode="Compact"
                                                        Value="{x:Bind Priority, Mode=TwoWay}"
                                                        ValueChanged="OnProviderPriorityChanged" />
                                                    <ToggleSwitch
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        AutomationProperties.Name="{x:Bind Name}"
                                                        IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                                        Toggled="OnProviderEnabledToggled" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="18">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="外观与动态效果" />
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="颜色模式" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="默认跟随 Windows，也可为本应用固定深色或浅色。" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SystemThemeStatusText" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" Text="当前跟随 Windows" />
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeSelector" Grid.Column="1" AutomationProperties.Name="颜色模式" HorizontalAlignment="Stretch" SelectionChanged="OnThemeSelectionChanged">
                                            <ComboBoxItem Content="跟随 Windows" Tag="system" />
                                            <ComboBoxItem Content="浅色" Tag="light" />
                                            <ComboBoxItem Content="深色" Tag="dark" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="窗口材质" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="亚克力更通透，云母更克制；系统关闭透明效果时会自动回退为实色。" TextWrapping="Wrap" />
                                            <TextBlock x:Name="MaterialStatusText" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="MaterialSelector"
                                            Grid.Column="1"
                                            AutomationProperties.Name="窗口材质"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="OnMaterialSelectionChanged">
                                            <ComboBoxItem Content="透明亚克力（推荐）" Tag="acrylic" />
                                            <ComboBoxItem Content="云母" Tag="mica" />
                                            <ComboBoxItem Content="实色" Tag="solid" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="减少动态效果" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="关闭非必要的进入、Toast 和按压动画。" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ReducedMotionToggle" Grid.Column="1" AutomationProperties.Name="减少动态效果" Toggled="OnReducedMotionToggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <StackPanel Spacing="3">
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="自定义分类规则" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="文件名命中匹配文本时，优先归入指定系列。" />
                                        </StackPanel>
                                        <Button
                                            x:Name="AddRuleButton"
                                            HorizontalAlignment="Right"
                                            AutomationProperties.Name="添加自定义分类规则"
                                            Click="OnAddRuleClick"
                                            Style="{StaticResource ToolbarButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                                <TextBlock Text="添加规则" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ListView
                                        x:Name="RulesList"
                                        MaxHeight="310"
                                        AutomationProperties.Name="自定义分类规则列表"
                                        ItemsSource="{x:Bind Rules}"
                                        SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,3" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:EditableRule">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        AutomationProperties.Name="规则匹配文本"
                                                        MaxLength="240"
                                                        PlaceholderText="匹配文本，例如：刀剑神域"
                                                        Text="{x:Bind Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        TextChanged="OnSettingsTextChanged" />
                                                    <TextBox
                                                        Grid.Column="1"
                                                        AutomationProperties.Name="规则目标系列"
                                                        MaxLength="120"
                                                        PlaceholderText="目标系列，例如：刀剑神域"
                                                        Text="{x:Bind Series, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        TextChanged="OnSettingsTextChanged" />
                                                    <Button Grid.Column="2" AutomationProperties.Name="删除规则" Click="OnDeleteRuleClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="删除规则">
                                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="RulesEmptyText" Style="{StaticResource MutedTextStyle}" Text="尚未添加自定义规则。" />
                                </StackPanel>
                            </Border>

                            </StackPanel>
                        </ScrollViewer>
                        <Border
                            x:Name="SettingsSaveBar"
                            Grid.Row="1"
                            MaxWidth="900"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource ElevatedCardBorderStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="SettingsDirtyIcon" FontSize="13" Foreground="{ThemeResource SuccessTextBrush}" Glyph="&#xE73E;" />
                                    <TextBlock x:Name="SettingsDirtyText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="识别设置已保存" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="ResetSettingsButton"
                                        AutomationProperties.Name="恢复当前已保存的设置"
                                        Click="OnResetSettingsClick"
                                        Style="{StaticResource ToolbarButtonStyle}">
                                        <TextBlock Text="恢复当前已保存值" />
                                    </Button>
                                    <Button
                                        x:Name="SaveSettingsButton"
                                        AutomationProperties.AcceleratorKey="Control+S"
                                        AutomationProperties.Name="保存设置"
                                        Click="OnSaveSettingsClick"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="保存设置 (Ctrl+S)">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="S" Modifiers="Control" />
                                        </Button.KeyboardAccelerators>
                                        <TextBlock Text="保存设置" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <TeachingTip
            x:Name="UsageTip"
            ActionButtonContent="选择目录"
            AutomationProperties.Name="安全整理使用提示"
            CloseButtonContent="知道了"
            IsLightDismissEnabled="True"
            ShouldConstrainToRootBounds="True"
            Subtitle="选择目录后先扫描预览；你可以检查、筛选和修正结果，确认整理后会生成可撤销报告。"
            Title="先预览，再整理" />

        <Border
            x:Name="ToastHost"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="状态通知"
            MinWidth="320"
            MaxWidth="440"
            Margin="0,16,28,0"
            Padding="14,12"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{ThemeResource TransientSurfaceBrush}"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0"
            Visibility="Collapsed"
            Canvas.ZIndex="100">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="ToastIcon" VerticalAlignment="Top" FontSize="16" Glyph="&#xE946;" />
                <TextBlock x:Name="ToastMessageText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" AutomationProperties.Name="关闭通知" Click="OnDismissToastClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="关闭通知">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
