<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LightNovelSelector.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LightNovelSelector.WinUI.Converters"
    xmlns:local="using:LightNovelSelector.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Styles/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StatusBrushConverter x:Key="StatusBrushConverter" />
            <converters:StatusGlyphConverter x:Key="StatusGlyphConverter" />
            <converters:LogKindConverter x:Key="LogKindConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
