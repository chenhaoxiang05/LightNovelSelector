<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LightNovelSelector.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LightNovelSelector.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing x:Name="StartupProgress" IsActive="True" Width="32" Height="32" />
            <TextBlock x:Name="StartupTitle" Text="正在连接分类核心" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="StartupMessage"
                MaxWidth="520"
                Text="正在启动本地 Python 服务…"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
