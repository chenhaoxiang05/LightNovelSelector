<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="CardBackgroundColor">#D9FFFFFF</Color>
            <Color x:Key="CardHoverColor">#F2FFFFFF</Color>
            <Color x:Key="CardBorderColor">#18000000</Color>
            <Color x:Key="SubtleSurfaceColor">#0A000000</Color>
            <Color x:Key="AccentColor">#0F6CBD</Color>
            <Color x:Key="AccentSubtleColor">#160F6CBD</Color>
            <Color x:Key="SuccessColor">#0F7B0F</Color>
            <Color x:Key="SuccessSubtleColor">#140F7B0F</Color>
            <Color x:Key="WarningColor">#9D5D00</Color>
            <Color x:Key="WarningSubtleColor">#18D99000</Color>
            <Color x:Key="ErrorColor">#C42B1C</Color>
            <Color x:Key="ErrorSubtleColor">#16C42B1C</Color>
            <AcrylicBrush
                x:Key="TransientSurfaceBrush"
                FallbackColor="#FFF7F8FA"
                TintColor="#FFF7F8FA"
                TintLuminosityOpacity="0.72"
                TintOpacity="0.82" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="CardBackgroundColor">#B21D2025</Color>
            <Color x:Key="CardHoverColor">#D1262A31</Color>
            <Color x:Key="CardBorderColor">#24FFFFFF</Color>
            <Color x:Key="SubtleSurfaceColor">#10FFFFFF</Color>
            <Color x:Key="AccentColor">#4A9EFF</Color>
            <Color x:Key="AccentSubtleColor">#244A9EFF</Color>
            <Color x:Key="SuccessColor">#6CCB5F</Color>
            <Color x:Key="SuccessSubtleColor">#206CCB5F</Color>
            <Color x:Key="WarningColor">#F2B84B</Color>
            <Color x:Key="WarningSubtleColor">#22F2B84B</Color>
            <Color x:Key="ErrorColor">#FF8A78</Color>
            <Color x:Key="ErrorSubtleColor">#22FF8A78</Color>
            <AcrylicBrush
                x:Key="TransientSurfaceBrush"
                FallbackColor="#F21D2025"
                TintColor="#FF1D2025"
                TintLuminosityOpacity="0.64"
                TintOpacity="0.80" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="CardBackgroundColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="CardHoverColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="CardBorderColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="SubtleSurfaceColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="AccentColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="AccentSubtleColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="SuccessColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="SuccessSubtleColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="WarningColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="WarningSubtleColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="ErrorColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="ErrorSubtleColor">{ThemeResource SystemColorWindowColor}</Color>
            <SolidColorBrush x:Key="TransientSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{ThemeResource CardHoverColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource CardBorderColor}" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{ThemeResource SubtleSurfaceColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{ThemeResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{ThemeResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{ThemeResource SuccessSubtleColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{ThemeResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{ThemeResource WarningSubtleColor}" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{ThemeResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{ThemeResource ErrorSubtleColor}" />

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="CompactCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="PillBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="9,4" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ResultListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
    </Style>

    <Style x:Key="ResultItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="SecondaryIconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
