<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BackdropToneColor">#05000000</Color>
            <Color x:Key="LowCardBackgroundColor">#30FFFFFF</Color>
            <Color x:Key="CardBackgroundColor">#5CFFFFFF</Color>
            <Color x:Key="ElevatedCardBackgroundColor">#92FFFFFF</Color>
            <Color x:Key="CardHoverColor">#72FFFFFF</Color>
            <Color x:Key="CardBorderHighlightColor">#2EFFFFFF</Color>
            <Color x:Key="CardBorderShadowColor">#0D000000</Color>
            <Color x:Key="LowCardBorderHighlightColor">#12FFFFFF</Color>
            <Color x:Key="LowCardBorderShadowColor">#08000000</Color>
            <Color x:Key="ElevatedCardBorderHighlightColor">#70FFFFFF</Color>
            <Color x:Key="ElevatedCardBorderShadowColor">#14000000</Color>
            <Color x:Key="SubtleSurfaceColor">#0A000000</Color>
            <Color x:Key="DividerColor">#14000000</Color>
            <Color x:Key="NavigationSelectionColor">#180F6CBD</Color>
            <Color x:Key="ListHoverColor">#6EFFFFFF</Color>
            <Color x:Key="ListPressedColor">#1F0F6CBD</Color>
            <Color x:Key="ListSelectedColor">#260F6CBD</Color>
            <Color x:Key="ListSelectedHoverColor">#340F6CBD</Color>
            <Color x:Key="AccentColor">#0F6CBD</Color>
            <Color x:Key="AccentSubtleColor">#160F6CBD</Color>
            <Color x:Key="SuccessColor">#0F7B0F</Color>
            <Color x:Key="SuccessSubtleColor">#140F7B0F</Color>
            <Color x:Key="WarningColor">#9D5D00</Color>
            <Color x:Key="WarningSubtleColor">#18D99000</Color>
            <Color x:Key="ErrorColor">#C42B1C</Color>
            <Color x:Key="ErrorSubtleColor">#16C42B1C</Color>
            <AcrylicBrush
                x:Key="TransientSurfaceBrush"
                FallbackColor="#FFF7F8FA"
                TintColor="#FFF7F8FA"
                TintLuminosityOpacity="0.74"
                TintOpacity="0.62" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <AcrylicBrush
                x:Key="NavigationViewDefaultPaneBackground"
                FallbackColor="#F2F7FAFF"
                TintColor="#FFF4F8FF"
                TintLuminosityOpacity="0.80"
                TintOpacity="0.14" />
            <AcrylicBrush
                x:Key="NavigationViewExpandedPaneBackground"
                FallbackColor="#F2F7FAFF"
                TintColor="#FFF4F8FF"
                TintLuminosityOpacity="0.80"
                TintOpacity="0.14" />
            <AcrylicBrush
                x:Key="NavigationViewTopPaneBackground"
                FallbackColor="#F2F7FAFF"
                TintColor="#FFF4F8FF"
                TintLuminosityOpacity="0.80"
                TintOpacity="0.14" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BackdropToneColor">#10080C12</Color>
            <Color x:Key="LowCardBackgroundColor">#3010151B</Color>
            <Color x:Key="CardBackgroundColor">#52151A20</Color>
            <Color x:Key="ElevatedCardBackgroundColor">#8C1B2027</Color>
            <Color x:Key="CardHoverColor">#661F252D</Color>
            <Color x:Key="CardBorderHighlightColor">#1FFFFFFF</Color>
            <Color x:Key="CardBorderShadowColor">#20000000</Color>
            <Color x:Key="LowCardBorderHighlightColor">#14FFFFFF</Color>
            <Color x:Key="LowCardBorderShadowColor">#10000000</Color>
            <Color x:Key="ElevatedCardBorderHighlightColor">#42FFFFFF</Color>
            <Color x:Key="ElevatedCardBorderShadowColor">#2A000000</Color>
            <Color x:Key="SubtleSurfaceColor">#0FFFFFFF</Color>
            <Color x:Key="DividerColor">#1CFFFFFF</Color>
            <Color x:Key="NavigationSelectionColor">#2E4A9EFF</Color>
            <Color x:Key="ListHoverColor">#3DFFFFFF</Color>
            <Color x:Key="ListPressedColor">#334A9EFF</Color>
            <Color x:Key="ListSelectedColor">#3D4A9EFF</Color>
            <Color x:Key="ListSelectedHoverColor">#4A4A9EFF</Color>
            <Color x:Key="AccentColor">#4A9EFF</Color>
            <Color x:Key="AccentSubtleColor">#244A9EFF</Color>
            <Color x:Key="SuccessColor">#6CCB5F</Color>
            <Color x:Key="SuccessSubtleColor">#206CCB5F</Color>
            <Color x:Key="WarningColor">#F2B84B</Color>
            <Color x:Key="WarningSubtleColor">#22F2B84B</Color>
            <Color x:Key="ErrorColor">#FF8A78</Color>
            <Color x:Key="ErrorSubtleColor">#22FF8A78</Color>
            <AcrylicBrush
                x:Key="TransientSurfaceBrush"
                FallbackColor="#F21D2025"
                TintColor="#FF1D2025"
                TintLuminosityOpacity="0.58"
                TintOpacity="0.68" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <AcrylicBrush
                x:Key="NavigationViewDefaultPaneBackground"
                FallbackColor="#F21D2025"
                TintColor="#FF15191F"
                TintLuminosityOpacity="0.64"
                TintOpacity="0.26" />
            <AcrylicBrush
                x:Key="NavigationViewExpandedPaneBackground"
                FallbackColor="#F21D2025"
                TintColor="#FF15191F"
                TintLuminosityOpacity="0.64"
                TintOpacity="0.26" />
            <AcrylicBrush
                x:Key="NavigationViewTopPaneBackground"
                FallbackColor="#F21D2025"
                TintColor="#FF15191F"
                TintLuminosityOpacity="0.64"
                TintOpacity="0.26" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="BackdropToneColor">Transparent</Color>
            <Color x:Key="LowCardBackgroundColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="CardBackgroundColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="ElevatedCardBackgroundColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="CardHoverColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="CardBorderHighlightColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="CardBorderShadowColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="LowCardBorderHighlightColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="LowCardBorderShadowColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="ElevatedCardBorderHighlightColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="ElevatedCardBorderShadowColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="SubtleSurfaceColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="DividerColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="NavigationSelectionColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="ListHoverColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="ListPressedColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="ListSelectedColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="ListSelectedHoverColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="AccentColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="AccentSubtleColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="SuccessColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="SuccessSubtleColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="WarningColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="WarningSubtleColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="ErrorColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="ErrorSubtleColor">{ThemeResource SystemColorWindowColor}</Color>
            <SolidColorBrush x:Key="TransientSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="BackdropToneBrush" Color="{ThemeResource BackdropToneColor}" />
    <SolidColorBrush x:Key="LowCardBackgroundBrush" Color="{ThemeResource LowCardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="ElevatedCardBackgroundBrush" Color="{ThemeResource ElevatedCardBackgroundColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{ThemeResource CardHoverColor}" />
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="{ThemeResource CardBorderHighlightColor}" />
        <GradientStop Offset="1" Color="{ThemeResource CardBorderShadowColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LowCardBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="{ThemeResource LowCardBorderHighlightColor}" />
        <GradientStop Offset="1" Color="{ThemeResource LowCardBorderShadowColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ElevatedCardBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="{ThemeResource ElevatedCardBorderHighlightColor}" />
        <GradientStop Offset="1" Color="{ThemeResource ElevatedCardBorderShadowColor}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{ThemeResource SubtleSurfaceColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource DividerColor}" />
    <SolidColorBrush x:Key="NavigationSelectionBrush" Color="{ThemeResource NavigationSelectionColor}" />
    <SolidColorBrush x:Key="GlassListHoverBrush" Color="{ThemeResource ListHoverColor}" />
    <SolidColorBrush x:Key="GlassListPressedBrush" Color="{ThemeResource ListPressedColor}" />
    <SolidColorBrush x:Key="GlassListSelectedBrush" Color="{ThemeResource ListSelectedColor}" />
    <SolidColorBrush x:Key="GlassListSelectedHoverBrush" Color="{ThemeResource ListSelectedHoverColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{ThemeResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{ThemeResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{ThemeResource SuccessSubtleColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{ThemeResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{ThemeResource WarningSubtleColor}" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{ThemeResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{ThemeResource ErrorSubtleColor}" />

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="CompactCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="LowCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CompactCardBorderStyle}">
        <Setter Property="Background" Value="{ThemeResource LowCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LowCardBorderBrush}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="ElevatedCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CompactCardBorderStyle}">
        <Setter Property="Background" Value="{ThemeResource ElevatedCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ElevatedCardBorderBrush}" />
    </Style>

    <Style x:Key="HeroCardBorderStyle" TargetType="Border" BasedOn="{StaticResource ElevatedCardBorderStyle}">
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="WorkspaceSurfaceBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="ContentRegionBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="DetailRegionBorderStyle" TargetType="Border" BasedOn="{StaticResource ContentRegionBorderStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="OverlayDetailRegionBorderStyle" TargetType="Border" BasedOn="{StaticResource DetailRegionBorderStyle}">
        <Setter Property="Background" Value="{ThemeResource TransientSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ElevatedCardBorderBrush}" />
        <Setter Property="CornerRadius" Value="8,0,0,8" />
    </Style>

    <Style x:Key="MetricTileBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
        <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="EyebrowTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
    </Style>

    <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="PillBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="9,4" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ResultListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
    </Style>

    <Style x:Key="ResultItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="SecondaryIconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
